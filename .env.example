# Copy this file to .env.local (git ignores it) and set the path for your
# machine. tools/paths.ts reads it for the dev server, the tests and the gen
# scripts alike; a variable set in the environment wins over the file.
# Relative paths are resolved from this directory.

# The MechWarrior 2 install: MW2.PRJ, MW2.EXE, MW2SHELL.EXE, the .MW2
# archives, GIDDI/, and the game CD - its image's .CUE/.BIN, or (a ripped CD)
# its SMK/, LAUNCH/ and KEATING/ directories. Nothing from it is copied into
# this repo.
MW2_ROOT=C:/games/dosgames/MECH2/MECH2
