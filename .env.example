# Copy this file to .env.local (git ignores it) and set both paths for your
# machine. tools/paths.ts reads it for the dev server, the tests and the gen
# scripts alike; a variable set in the environment wins over the file.
# Relative paths are resolved from this directory.

# The MechWarrior 2 install: MW2.PRJ, MW2.EXE, MW2SHELL.EXE, the .MW2
# archives, GIDDI/, and the CD image's .CUE/.BIN. Nothing from it is copied
# into this repo.
MW2_ROOT=C:/games/dosgames/MECH2/MECH2

# The decompilation (the mw2-decompiled repo's decompiled/ directory): needed
# by `npm run gen`, the golden tests and the editor's source view - not to
# build or play.
MW2_DECOMPILED=C:/games/dosgames/MECH2/MECH2/decompiled
